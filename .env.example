# Vorlage. Kopieren nach .env und ausfuellen. .env ist gitignored.
#
# QUOTING-REGEL - hat in diesem Projekt schon zweimal zugeschlagen:
#   * KEINE Anfuehrungszeichen um Werte. Compose nimmt sie woertlich mit.
#   * KEIN #  - leitet einen Kommentar ein, der Rest des Wertes ist weg.
#   * KEIN $  - Compose interpoliert das als Variable.
# Passwoerter deshalb rein alphanumerisch erzeugen:
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
# Nach dem Start pruefen, dass der Container den vollen String sieht:
#   docker compose exec meshcore-mqtt printenv MQTT_PASSWORD | od -c

# --- MeshCore-Node (Heltec V3, Companion TCP) ---
MESHCORE_HOST=
MESHCORE_PORT=5000

# --- Topic-Prefix ---
# Bewusst NICHT "meshcore" - das gehoert dem Observer-Stack auf dem Observer-Host.
# Getrennte Prefixe, damit Kommandos und Beobachtungen sich nicht mischen.
# ACHTUNG: config/mosquitto/acl enthaelt den Prefix fest verdrahtet. Wer hier
# etwas anderes eintraegt, muss die ACL-Datei mit aendern.
MQTT_PREFIX=meshinfra

# --- Broker-Benutzer ---
# Drei getrennte Konten, weil die ACL sie trennt. Wuerde man ein einziges
# Konto nehmen, koennte jeder Einlieferer direkt auf meshinfra/command/#
# publizieren und das Rate-Limit umgehen.
#
# infra  - die Einlieferer (Alerts, Monitoring, AI-Agent). Nur meshinfra/tx/#
MQTT_USER=infra
MQTT_PASS=
# gate   - das Rate-Limit-Gate. Einziger Schreiber auf meshinfra/command/#
GATE_USER=gate
GATE_PASS=
# bridge - meshcore-mqtt
BRIDGE_USER=bridge
BRIDGE_PASS=

# --- Rate Limit (eigener Layer, siehe README) ---
# Hoechstens so viele Nachrichten pro rollender Stunde. Rest wird verworfen
# und auf meshinfra/gate/dropped gemeldet. Pflicht, nicht Kuer: 868 MHz ist
# SRD-Band mit Sendezeitbegrenzung.
RATE_LIMIT_PER_HOUR=12
# Kanalindex fuer meshinfra/tx/chan ohne explizites "channel"-Feld.
# MUSS der eigene Automatik-Kanal sein, NIE der Gemeinschaftskanal (0).
DEFAULT_CHANNEL=1
# Laengere Nachrichten werden gekuerzt. Airtime.
MAX_MSG_LEN=140

# --- Broker-Bindung ---
# Bleibt LAN-intern. Kein Traefik, keine Exposition nach aussen.
# Auf 127.0.0.1 setzen, wenn nur der Stack-Host selbst publizieren soll.
MOSQUITTO_BIND=0.0.0.0
MOSQUITTO_HOST_PORT=1883

LOG_LEVEL=INFO

# Upstream-Version von meshcore-mqtt. Wird lokal gebaut, siehe compose.
MESHCORE_MQTT_VERSION=v0.1.3

# --- Sendefenster (Web-Tool) ---
# Beschriftung der Kanaele im Auswahlfeld. Format: index=Name, kommagetrennt.
# Muss von Hand gepflegt werden - Kanaele lassen sich ueber MQTT nicht abfragen.
CHANNEL_LABELS=0=Public,2=<KANAL>
# LAN-intern. Auf 127.0.0.1 setzen, wenn nur der Stack-Host selbst zugreifen soll.
WEBUI_BIND=0.0.0.0
WEBUI_HOST_PORT=8080
